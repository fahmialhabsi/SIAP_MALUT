{
  "name": "siap-malut",
  "version": "0.1.0",
  "private": true,
  "description": "Sistem Informasi Administrasi Pimpinan Maluku Utara",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/domain",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "lint": "eslint . && prettier --check . && node scripts/cek-token.mjs",
    "lint:token": "node scripts/cek-token.mjs",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present && node --test scripts/cek-token.test.mjs scripts/alamat-lan.test.mjs",
    "build": "npm run build --workspaces --if-present",
    "sbom": "node scripts/buat-sbom.mjs",
    "docs:status": "node scripts/buat-diagram-status.mjs",
    "admin:sandi": "npm run seed -w apps/api -- --atur-sandi-admin",
    "docs:data": "node scripts/buat-kamus-data.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
