# Salin menjadi .env. JANGAN memasukkan rahasia ke berkas contoh ini. .env tidak boleh di-commit.

# demo = data contoh + spanduk DATA CONTOH + pindah tampilan peran (hanya pengembangan/evaluasi)
# production = (bawaan) menolak data contoh
APP_MODE=production

# Port web yang dibuka di komputer/server (API hanya dapat diakses lewat web: /api, /health, /ready)
WEB_PORT=8080

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# WAJIB: kata sandi basis data PostgreSQL (gunakan huruf/angka agar aman di URL; minimal 16 karakter)
POSTGRES_PASSWORD=

# Opsional: kata sandi awal admin.owner pada mode demo (minimal 12 karakter).
# Kosong = dibuat acak dan dicetak SEKALI di log API (docker compose logs api).
SIAP_ADMIN_PASSWORD=
